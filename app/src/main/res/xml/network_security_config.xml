<?xml version="1.0" encoding="utf-8"?>
<!--
  Fail closed: cleartext is permitted only for local Nostr relay access
  (Citrine on the device loopback at ws://localhost:4869). Public relay
  connections are wss://; media is fetched over https.

  Why base-config is false: OkHttp 4.12 honors the per-host network
  security policy for cleartext (RealConnection -> Platform#isCleartextTrafficPermitted),
  and its default connection specs include CLEARTEXT, so a base-config of
  "true" lets a user-added ws:// relay - or any http:// media host - talk
  in plaintext on every API level. Through Tor that still exits in the
  clear at the exit node; fail closed instead.

  Android 8 (API 26) TLS fix lives in RelayConnection.kt: connection specs
  are widened to TLS 1.3/1.2 with the platform trust store for API 26-28;
  no custom TrustManager anywhere.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
