<?xml version="1.0" encoding="utf-8"?>
<!--
  Cleartext is permitted for legacy HTTP media and local Nostr relay access.
  Public relay connections should use WSS; Citrine is commonly available on
  the device loopback at ws://localhost:4869. When Tor is enabled, only this
  local relay traffic bypasses Orbot; public traffic continues through Tor.
  
  Android 8 (API 26) Fix: Custom TrustManager and modern CA bundle fallback
  are handled in RelayConnection.kt for TLS 1.3 and Let's Encrypt ISRG Root X2.
  Network security config explicitly trusts modern roots for API 26-28 via code.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
